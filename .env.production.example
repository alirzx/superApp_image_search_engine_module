# SuperApp Module 04: production template; supply through GitLab ENV_FILE File variable or server secret store.
APP_ENV=production
API_AUTH_ENABLED=true
API_KEY=
API_BIND_IP=127.0.0.1
API_PORT=8004
# LAN/VPN bind. Ensure firewall permits port 8085 only from trusted subnets.
WEB_BIND=192.168.4.209
WEB_PORT=8085
MODEL_ID=google/siglip2-base-patch32-256
# Immutable HF commit SHA from scripts/download_model.py
MODEL_REVISION=
MODEL_PATH=./.models/siglip2
DATA_PATH=./.data
# Match the service owner on the target server (id -u; id -g).
RUN_UID=1000
RUN_GID=1000
INFERENCE_THREADS=2
API_CPUS=4
API_MEMORY_LIMIT=6g
UI_CPUS=0.5
UI_MEMORY_LIMIT=256m
MAX_IMAGE_SIZE_MB=10
MAX_IMAGE_PIXELS=20000000
MAX_TOP_K=50
MAX_BATCH_IMAGES=20

# Build-time Python package sources, priority: Liara -> Chabokan -> PyPI.
PIP_PRIMARY_INDEX_URL=https://package-mirror.liara.ir/repository/pypi/simple
PIP_SECONDARY_INDEX_URL=https://mirror2.chabokan.net/pypi/simple/
PIP_FALLBACK_INDEX_URL=https://pypi.org/simple
# CPU-only PyTorch wheel fallback (PyPI itself may select a CUDA-enabled wheel).
PYTORCH_CPU_INDEX_URL=https://download.pytorch.org/whl/cpu
SETUP_CPUS=2
SETUP_MEMORY_LIMIT=2g

# Debian Bookworm APT mirrors: signed metadata + HTTPS fallback at image build.
APT_PRIMARY_DEBIAN_URL=https://mirror.metanet.ch/debian
APT_PRIMARY_SECURITY_URL=https://mirror.metanet.ch/debian-security
APT_FALLBACK_DEBIAN_URL=https://mirrors.huaweicloud.com/repository/debian
APT_FALLBACK_SECURITY_URL=https://mirrors.huaweicloud.com/repository/debian-security
