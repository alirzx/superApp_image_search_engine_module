# SuperApp Module 04: local development only; copy as .env and never commit secrets.
APP_ENV=development
API_AUTH_ENABLED=true
API_KEY=
API_BIND_IP=127.0.0.1
API_PORT=8004
WEB_BIND=127.0.0.1
WEB_PORT=8085
MODEL_ID=google/siglip2-base-patch32-256
# Immutable HF commit SHA from scripts/download_model.py
MODEL_REVISION=
MODEL_PATH=./.models/siglip2
DATA_PATH=./.data
# Match the owner of the bind-mount directories (id -u; id -g).
RUN_UID=1000
RUN_GID=1000
INFERENCE_THREADS=2
API_CPUS=4
API_MEMORY_LIMIT=6g
UI_CPUS=0.5
UI_MEMORY_LIMIT=256m
MAX_IMAGE_SIZE_MB=10
MAX_IMAGE_PIXELS=20000000
MAX_TOP_K=50
MAX_BATCH_IMAGES=20
